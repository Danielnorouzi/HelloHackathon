# Copy this file to .env and fill in your keys. Never commit .env.

# --- LLM (scouting reports + training plans) ---
# LLM_PROVIDER: "anthropic" or "openai" (any OpenAI-compatible endpoint works via LLM_BASE_URL)
# Examples: anthropic + claude-sonnet-5 (key starts sk-ant-), or openai + gpt-5.5 (key starts sk-proj-)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=

# --- API-Football (free tier: 100 requests/day) ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Offline demo mode: when true, never call external APIs; serve cache only ---
OFFLINE_MODE=false

# --- SQLite database path (relative to backend/) ---
DATABASE_PATH=data/soccer.db

# --- Live Skills Coach (optional; tracking and on-screen cues work without any of this) ---
# Coaching data is kept in its own database, separate from the player-analysis data.
COACH_DATABASE_PATH=data/coach.db
# Faster/cheaper model for short spoken answers (defaults to LLM_MODEL).
COACH_LLM_MODEL=
# Voice = OpenAI-compatible speech APIs. With LLM_PROVIDER=openai the LLM key is reused.
VOICE_ENABLED=true
VOICE_API_KEY=
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral
VOICE_STT_MODEL=gpt-4o-mini-transcribe
